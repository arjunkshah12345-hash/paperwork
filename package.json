{
  "name": "paperwork-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "A free, open-source, local-first PDF toolkit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "predev": "node scripts/package-source.mjs",
    "prebuild": "node scripts/package-source.mjs",
    "build": "tsc -b && vite build && node scripts/seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/instrument-serif": "^5.2.5",
    "@huggingface/transformers": "^4.3.2",
    "@libpdf/core": "^0.5.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.15.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spark-md5": "^3.0.2",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/spark-md5": "^3.0.5",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
